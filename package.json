{
  "name": "aeronav-ai",
  "version": "1.0.0",
  "description": "AeroNav AI — Waypoint Mission & Flight Planner",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w serialport",
    "postinstall": "electron-rebuild -f -w serialport",
    "generate-installer-assets": "python scripts/generate-installer-assets.py",
    "prebuild:win": "python scripts/generate-installer-assets.py",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.aeronav.ai",
    "productName": "AeroNav AI",
    "npmRebuild": true,
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "js/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AeroNav AI",
      "include": "build/installer.nsh",
      "installerSidebar": "build/sidebar.bmp",
      "uninstallerSidebar": "build/sidebar-uninstall.bmp"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    }
  }
}
